# 服务监听端口。docker-compose.yml 默认把宿主机 8789 映射到容器 8789。
PORT=8789

# 对外访问路径。反代到 https://你的域名/check/ 时填 /check；直接占用根路径就留空或 /。
PUBLIC_BASE_PATH=/check

# SQLite 文件，相对项目根目录。
CHECK_DB_FILE=./data/check.db

# 计算“今天/下一次执行时间”的时区，Cron 表达式也按这个时区解释。
CHECK_TIMEZONE=Asia/Shanghai

# 管理后台密码；为空时管理端接口全部禁用（看板仍然可读）。
CHECK_ADMIN_PASSWORD=change-this-password

# 看板标题与副标题。
CHECK_TITLE=模型智商检测
CHECK_SUBTITLE=用同一道固定试题，横向对比各分组模型的真实生成表现。

# 首次启动写入的定时任务（之后以管理后台的设置为准）。
# 标准 5 段 Cron：分 时 日 月 周。*/30 * * * * = 每 30 分钟检测一轮。
CHECK_CRON=*/30 * * * *
CHECK_CRON_ENABLED=true

# 单次模型调用超时（秒）与单份作品最大保存字符数。
CHECK_REQUEST_TIMEOUT_SECONDS=180
CHECK_MAX_OUTPUT_CHARS=200000

# 是否允许把分组的 reasoning 值（low/medium/high）作为 reasoning_effort 发给上游。
CHECK_SEND_REASONING_EFFORT=true

# 测试用：设为 true 时不启用内部定时器（只保留手动触发）。
CHECK_DISABLE_SCHEDULER=false
